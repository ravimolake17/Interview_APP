# Copy to backend/.env and fill secrets. Never commit .env.
#
# Local: keep AGENT5_EMBEDDED=true and localhost URLs (one process on :8030).
# Production (two VMs): see APP VM / PROCTOR VM blocks at the bottom.

# Seeded SuperAdmin after alembic 019 — change immediately in production:
#   email: superadmin@rrglobal.com
#   password: SuperAdmin@1234

DEBUG=false

# Public HR URL used in candidate emails (schedule + join links).
# Local: http://localhost:5173  or  http://127.0.0.1:8030 after npm run build
# Production App VM: http://20.244.34.0:8030  (or https://app.yourcompany.com later)
FRONTEND_URL=http://localhost:5173

# Database (async). Local default user is postgres.
# Production App VM: postgresql+asyncpg://interview_app:YOUR_DB_PASSWORD@127.0.0.1:5432/interview_scheduler
# Production Proctor VM: same DB on App private IP 172.16.0.4 (not 172.17.0.4)
DATABASE_URL=postgresql+asyncpg://postgres:rradmin@127.0.0.1:5432/interview_scheduler

# LangGraph checkpoint (sync URL — same database as DATABASE_URL)
CHECKPOINT_DB_URL=postgresql://postgres:rradmin@127.0.0.1:5432/interview_scheduler

# SMTP Email (Agent 2). SuperAdmin can override per company after login.
# Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_USE_TLS=true SMTP_USE_SSL=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply.rrparkon@rrglobal.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM_EMAIL=noreply.rrparkon@rrglobal.com
SMTP_FROM_NAME=RR Parkon HR Team
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30

# Scheduling (Agent 2)
TOKEN_EXPIRY_HOURS=48
INTERVIEW_DURATION_MINUTES=30

# Agent 3 — Interview Blueprint Planner
BLUEPRINT_MAX_JD_TEXT_CHARS=100000
BLUEPRINT_AUTO_GENERATE_ON_SHORTLIST=true

# Agent 1 — Resume Screening ATS
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=8192
SCREENING_PROMPT_STYLE=detailed_analysis
USE_LLM_FOR_JD_PARSING=true
USE_LLM_FOR_RESUME_PARSING=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=15
PDF_OCR_MODE=auto
ATS_SHORTLIST_THRESHOLD=75
ATS_REVIEW_THRESHOLD=55

# Optional Azure (also editable in SuperAdmin → LLM & AI / API & Integration)
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://interview-azure-openai.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus2

# Agent 1 — Async screening queue
SCREENING_QUEUE_ENABLED=true
SCREENING_EMBED_WORKERS=true
MAX_CONCURRENT_SCREENING_JOBS=20
MAX_CONCURRENT_EXTRACT_JOBS=1
GROQ_RATE_LIMIT_WAIT_SECONDS=480
SCREENING_BATCH_MAX_SIZE=100
SCREENING_WORKER_POLL_SECONDS=1.0
SCREENING_JOB_POLL_INTERVAL_MS=2000

# Extra CORS origins (comma-separated). Needed when App and Proctor have different public URLs.
# CORS_ORIGINS=http://20.244.34.0:8030,http://PROCTOR_PUBLIC_HOST:8030

# Agent 5 — Fraud detection / proctoring (same Postgres as DATABASE_URL)
# Local: AGENT5_EMBEDDED=true (camera APIs in uvicorn main:app)
# Production App VM: AGENT5_EMBEDDED=false
# Production Proctor VM: run  uvicorn agents.proctoring_agent.main:app
AGENT5_EMBEDDED=true
AGENT5_PUBLIC_URL=http://127.0.0.1:8030
AGENT5_SECRET_KEY=replace-with-at-least-32-random-bytes-for-production
AGENT5_CORS_ORIGINS=http://127.0.0.1:8030,http://localhost:8030,http://127.0.0.1:5173,http://localhost:5173
# Proctor VM only — public origin of Agent 4 / HR API:
# INTERVIEW_API_PUBLIC_URL=http://20.244.34.0:8030
# AGENT5_DATABASE_URL=postgresql://interview_app:YOUR_DB_PASSWORD@172.16.0.4:5432/interview_scheduler
# AGENT5_STORAGE_DIR=/opt/apps/Interview_Agentic_AI/backend/storage/agent5
# AGENT5_MODELS_DIR=/opt/apps/Interview_Agentic_AI/models/agent5
# AGENT5_TEST_MODE=0

# JWT (HR portal). Generate a long random string in production (not the default below).
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Production copy-paste (Interview-PRD-RG). Fill passwords/keys; do not commit.
#
# --- Interview-app (172.16.0.4, public 20.244.34.0) ---
# FRONTEND_URL=http://20.244.34.0:8030
# DATABASE_URL=postgresql+asyncpg://interview_app:YOUR_DB_PASSWORD@127.0.0.1:5432/interview_scheduler
# CHECKPOINT_DB_URL=postgresql://interview_app:YOUR_DB_PASSWORD@127.0.0.1:5432/interview_scheduler
# AGENT5_EMBEDDED=false
# AGENT5_PUBLIC_URL=http://PROCTOR_PUBLIC_HOST:8030
# AGENT5_SECRET_KEY=<same 32+ char secret on BOTH VMs>
# AGENT5_CORS_ORIGINS=http://20.244.34.0:8030,http://PROCTOR_PUBLIC_HOST:8030
# CORS_ORIGINS=http://20.244.34.0:8030,http://PROCTOR_PUBLIC_HOST:8030
# JWT_SECRET_KEY=<long random string>
#
# --- Interview-Proctor (172.17.0.4, snet-centralindia-2) ---
# FRONTEND_URL=http://20.244.34.0:8030
# DATABASE_URL=postgresql+asyncpg://interview_app:YOUR_DB_PASSWORD@172.16.0.4:5432/interview_scheduler
# CHECKPOINT_DB_URL=postgresql://interview_app:YOUR_DB_PASSWORD@172.16.0.4:5432/interview_scheduler
# AGENT5_DATABASE_URL=postgresql://interview_app:YOUR_DB_PASSWORD@172.16.0.4:5432/interview_scheduler
# AGENT5_PUBLIC_URL=http://PROCTOR_PUBLIC_HOST:8030
# AGENT5_SECRET_KEY=<MUST match App VM>
# AGENT5_CORS_ORIGINS=http://20.244.34.0:8030,http://PROCTOR_PUBLIC_HOST:8030
# INTERVIEW_API_PUBLIC_URL=http://20.244.34.0:8030
# AGENT5_STORAGE_DIR=/opt/apps/Interview_Agentic_AI/backend/storage/agent5
# AGENT5_MODELS_DIR=/opt/apps/Interview_Agentic_AI/models/agent5
# ---------------------------------------------------------------------------

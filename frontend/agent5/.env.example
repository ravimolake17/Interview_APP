# Build-time browser request timeouts. Values are milliseconds.
VITE_AGENT5_FRAME_REQUEST_TIMEOUT_MS=8000
VITE_AGENT5_AUDIO_REQUEST_TIMEOUT_MS=25000

# Visual attention capture cadence. One request is allowed in flight; stale frames are dropped.
VITE_AGENT5_FRAME_INTERVAL_MS=750
VITE_AGENT5_TAB_MIN_HIDDEN_MS=350

# Optional. Prefer INTERVIEW_API_PUBLIC_URL on the proctor VM (runtime).
# VITE_INTERVIEW_API_URL=https://app.yourcompany.com
